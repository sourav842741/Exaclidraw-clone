# API base URL used for REST calls. Defaults to /api (same origin).
VITE_API_URL=http://localhost:5000

# Socket.IO server URL. Defaults to window.location.origin.
VITE_SOCKET_URL=http://localhost:5000

# WebSocket URL for collaboration (yjs). Defaults to ws://<origin>/ws/collab.
VITE_WS_URL=ws://localhost:5000/ws/collab
