# App
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:3000
API_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:3000
STORAGE_DIR=../storage
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://localhost:27017/vectorshare

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES=7d
JWT_EMAIL_SECRET=change-me-email-secret

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VectorShare AI <no-reply@example.com>"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Yjs collaboration store (relative to server root)
YJS_STORE_DIR=../storage/yjs
